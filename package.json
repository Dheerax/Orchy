{
  "name": "orchy",
  "displayName": "Orchy",
  "description": "Multi-agent coding orchestration for VS Code. An orchestrator plans a pipeline you approve; every agent runs in its own git worktree; you watch the branches diverge and merge.",
  "version": "0.36.0",
  "license": "MIT",
  "publisher": "orchy",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dheerax/Orchy.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "orchyPanel",
          "title": "Orchy",
          "icon": "media/orchy.svg"
        }
      ]
    },
    "views": {
      "orchyPanel": [
        {
          "id": "orchy.workspaceView",
          "type": "webview",
          "name": "Orchy",
          "contextualTitle": "Orchy"
        }
      ]
    },
    "commands": [
      {
        "command": "orchy.spawn",
        "title": "Orchy: Spawn Agent Session",
        "icon": "$(add)"
      },
      {
        "command": "orchy.showGraph",
        "title": "Orchy: Open Workspace",
        "icon": "$(layout)"
      },
      {
        "command": "orchy.verify",
        "title": "Orchy: Verify Deliverables",
        "icon": "$(checklist)"
      },
      {
        "command": "orchy.merge",
        "title": "Orchy: Merge Session Into Main"
      },
      {
        "command": "orchy.archive",
        "title": "Orchy: Archive Session",
        "icon": "$(archive)"
      },
      {
        "command": "orchy.kill",
        "title": "Orchy: Kill Session",
        "icon": "$(stop-circle)"
      },
      {
        "command": "orchy.pruneWorktrees",
        "title": "Orchy: Prune Orphaned Worktrees"
      },
      {
        "command": "orchy.focusSession",
        "title": "Orchy: Focus Session"
      },
      {
        "command": "orchy.purge",
        "title": "Orchy: Remove Session From List",
        "icon": "$(trash)"
      },
      {
        "command": "orchy.purgeAll",
        "title": "Orchy: Clear All Sessions"
      },
      {
        "command": "orchy.openTranscript",
        "title": "Orchy: Open Session Transcript",
        "icon": "$(go-to-file)"
      },
      {
        "command": "orchy.showPipeline",
        "title": "Orchy: Open Pipeline Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "orchy.openTerminal",
        "title": "Orchy: Open Agent Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "orchy.checkSetup",
        "title": "Orchy: Check Setup"
      },
      {
        "command": "orchy.createProjectConfig",
        "title": "Orchy: Create Project Config"
      },
      {
        "command": "orchy.copyMcpConfig",
        "title": "Orchy: Copy MCP Server Config"
      },
      {
        "command": "orchy.openWorkspace",
        "title": "Orchy: Open Workspace"
      }
    ],
    "menus": {},
    "configuration": {
      "title": "Orchy",
      "properties": {
        "orchy.baseBranch": {
          "type": "string",
          "default": "main",
          "description": "Branch that agent worktrees are created from and merged back into."
        },
        "orchy.globalBudgetCap": {
          "type": "number",
          "default": 0,
          "description": "Stop any session whose estimated spend passes this. 0 disables the cap."
        },
        "orchy.sessionsPerPage": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 12,
          "description": "How many agent panes share the workspace at once. More sessions than this move to the next page. Twelve is the ceiling — past that the panes are too small to read."
        },
        "orchy.autoMerge": {
          "type": "boolean",
          "default": false,
          "description": "Merge a session automatically once its deliverables and contracts verify and the rebase is clean. Declines on anything ambiguous."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node out/core/stateLayer.test.js && node out/core/planner.test.js && node out/core/modelPolicy.test.js && node out/core/doctor.test.js && node out/core/projectConfig.test.js && node out/backends/binaryResolution.test.js && node out/ui/gridLayout.test.js && node out/ui/panelRender.test.js && node out/ui/railGraph.test.js && node out/core/integration.test.js && node mcp/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "multi-agent",
    "orchestration",
    "agents",
    "ai",
    "worktree",
    "git",
    "opencode",
    "mcp",
    "pipeline",
    "codegen"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "homepage": "https://github.com/Dheerax/Orchy#readme",
  "bugs": {
    "url": "https://github.com/Dheerax/Orchy/issues"
  },
  "qna": false
}
