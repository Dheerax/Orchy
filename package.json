{
  "name": "orchy",
  "displayName": "Orchy",
  "description": "Multi-agent coding orchestration for VS Code \u2014 a grid of isolated agents, driven by an orchestrator, with live topology.",
  "version": "0.0.9",
  "license": "MIT",
  "publisher": "orchy",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dheerax/Orchy.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "orchy",
          "title": "Orchy",
          "icon": "media/orchy.svg"
        }
      ]
    },
    "views": {
      "orchy": [
        {
          "id": "orchy.sessions",
          "name": "Sessions",
          "contextualTitle": "Orchy"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "orchy.sessions",
        "contents": "No agent sessions yet.\n\nEach session runs in its own git worktree and appears in the editor grid.\n\n[Spawn an agent](command:orchy.spawn)\n[Set up workspace layout](command:orchy.setupLayout)\n\nOr let an orchestrator drive it through the orchy-mcp tools."
      }
    ],
    "commands": [
      {
        "command": "orchy.spawn",
        "title": "Orchy: Spawn Agent Session",
        "icon": "$(add)"
      },
      {
        "command": "orchy.showGraph",
        "title": "Orchy: Show Topology",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "orchy.setupLayout",
        "title": "Orchy: Set Up Workspace Layout"
      },
      {
        "command": "orchy.verify",
        "title": "Orchy: Verify Deliverables",
        "icon": "$(checklist)"
      },
      {
        "command": "orchy.merge",
        "title": "Orchy: Merge Session Into Main"
      },
      {
        "command": "orchy.archive",
        "title": "Orchy: Archive Session",
        "icon": "$(archive)"
      },
      {
        "command": "orchy.kill",
        "title": "Orchy: Kill Session",
        "icon": "$(stop-circle)"
      },
      {
        "command": "orchy.pruneWorktrees",
        "title": "Orchy: Prune Orphaned Worktrees"
      },
      {
        "command": "orchy.focusSession",
        "title": "Orchy: Focus Session"
      },
      {
        "command": "orchy.purge",
        "title": "Orchy: Remove Session From List",
        "icon": "$(trash)"
      },
      {
        "command": "orchy.purgeAll",
        "title": "Orchy: Clear All Sessions"
      },
      {
        "command": "orchy.nextPage",
        "title": "Orchy: Next Page of Agents",
        "icon": "$(arrow-right)"
      },
      {
        "command": "orchy.previousPage",
        "title": "Orchy: Previous Page of Agents",
        "icon": "$(arrow-left)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "orchy.focusSession",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "orchy.spawn",
          "when": "view == orchy.sessions",
          "group": "navigation@1"
        },
        {
          "command": "orchy.showGraph",
          "when": "view == orchy.sessions",
          "group": "navigation@2"
        },
        {
          "command": "orchy.purgeAll",
          "when": "view == orchy.sessions",
          "group": "1_clear@1"
        },
        {
          "command": "orchy.pruneWorktrees",
          "when": "view == orchy.sessions",
          "group": "1_clear@2"
        }
      ],
      "view/item/context": [
        {
          "command": "orchy.verify",
          "when": "view == orchy.sessions && viewItem =~ /^orchySession/",
          "group": "inline@1"
        },
        {
          "command": "orchy.purge",
          "when": "view == orchy.sessions && viewItem =~ /^orchySession/",
          "group": "inline@2"
        },
        {
          "command": "orchy.merge",
          "when": "view == orchy.sessions && viewItem == orchySession.complete",
          "group": "1_act@1"
        },
        {
          "command": "orchy.kill",
          "when": "view == orchy.sessions && viewItem =~ /^orchySession/",
          "group": "9_danger@1"
        },
        {
          "command": "orchy.archive",
          "when": "view == orchy.sessions && viewItem =~ /^orchySession/",
          "group": "9_danger@2"
        },
        {
          "command": "orchy.purge",
          "when": "view == orchy.sessions && viewItem =~ /^orchySession/",
          "group": "9_danger@3"
        }
      ]
    },
    "configuration": {
      "title": "Orchy",
      "properties": {
        "orchy.baseBranch": {
          "type": "string",
          "default": "main",
          "description": "Branch that agent worktrees are created from and merged back into."
        },
        "orchy.visibleSlots": {
          "type": "number",
          "default": 12,
          "minimum": 1,
          "maximum": 12,
          "description": "How many agent terminals share the editor grid at once. The layout adapts to the count (two side by side, three as two-over-one, twelve as three rows of four). Sessions beyond this paginate."
        },
        "orchy.autoPromoteOnBlocked": {
          "type": "boolean",
          "default": true,
          "description": "When a session needs input, bring its terminal into a visible grid slot. Never steals focus."
        },
        "orchy.globalBudgetCap": {
          "type": "number",
          "default": 0,
          "description": "Stop any session whose estimated spend passes this. 0 disables the cap."
        },
        "orchy.useBackendTui": {
          "type": "boolean",
          "default": false,
          "description": "Run OpenCode's own terminal UI in agent panes instead of Orchy's transcript view. The backend TUI is interactive but has been seen to render an empty prompt while the agent is working."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node out/core/stateLayer.test.js && node out/backends/binaryResolution.test.js && node out/ui/gridLayout.test.js && node out/core/integration.test.js && node mcp/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
